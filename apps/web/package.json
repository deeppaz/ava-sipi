    "@deck.gl/extensions": "9.3.11",
    "@deck.gl/layers": "9.3.11",
    "@deck.gl/mapbox": "9.3.11",
    "@luma.gl/shadertools": "9.3.6",
    "culori": "4.0.2",
    "hyparquet": "1.29.2",
    "maplibre-gl": "5.24.0",
    "pmtiles": "4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/culori": "4.0.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
