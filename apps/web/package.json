{
  "name": "@ava-sipi/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ava Sipî web app — MapLibre globe + deck.gl layers.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
