# Ava Sipî — all keys are optional. Without them the app runs from cached snapshots.

# --- Web (Vite, exposed to the browser: never put secrets here) ---
# Root manifest URL. Leave empty to use data/samples (offline mode).
VITE_MANIFEST_URL=
# Edge proxy base for live sources. Leave empty to call upstream APIs directly.
VITE_WORKER_URL=
# Optional Sentry DSN (public). Empty = console logging only.
VITE_SENTRY_DSN=

# --- Worker (Cloudflare secrets: set with `wrangler secret put`) ---
# USGS_API_KEY=            raises USGS rate limit (api.waterdata.usgs.gov/signup)
# OPEN_METEO_API_KEY=      only needed for commercial use of Open-Meteo

# --- Ingest (GitHub Actions secrets) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ava-sipi
# R2_PUBLIC_URL=https://data.example.org
# USGS_API_KEY=
# EARTHDATA_USERNAME=      NASA Earthdata login (free) for GRACE mascons
# EARTHDATA_PASSWORD=
# CLOUDFLARE_API_TOKEN=    cache purge
# CLOUDFLARE_ZONE_ID=
