{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cell": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "enum": [
        "cm",
        "percentile"
      ]
    },
    "points": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          {
            "type": "number"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "required": [
    "cell",
    "unit",
    "points"
  ],
  "$id": "https://ava-sipi.dev/schema/groundwater-cell-series.json",
  "title": "groundwater-cell-series"
}
