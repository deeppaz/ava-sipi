{
  "name": "ava-sipi",
  "private": true,
  "version": "0.1.0",
  "description": "Ava Sip\u00ee \u2014 the living map of Earth's water",
  "license": "MIT",
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @ava-sipi/web dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "schema:export": "pnpm --filter @ava-sipi/schema export",
    "e2e": "pnpm --filter @ava-sipi/web e2e",
    "budget": "pnpm --filter @ava-sipi/web budget",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "ingest": "uv run --project ingest python -m ingest.cli"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@changesets/cli": "3.0.1",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "wrangler": "4.128.0"
  }
}
